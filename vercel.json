{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/coach.js": {
      "maxDuration": 60
    },
    "api/config.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
