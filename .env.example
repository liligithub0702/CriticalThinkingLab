# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for every coach response.
# Defaults to claude-opus-5.
# COACH_MODEL=claude-opus-5

# Optional: reasoning effort for coach responses - low | medium | high | xhigh | max
# Defaults to medium. Raise for sharper critique, lower for faster/cheaper replies.
# COACH_EFFORT=medium
